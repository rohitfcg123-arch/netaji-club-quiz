rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Player accounts are Google-only. Admins continue to use the allowlisted password account.
    function signedIn() {
      return request.auth != null;
    }

    function googlePlayer() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email is string;
    }

    function passwordUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function rootAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email == 'rohit.fcg123@gmail.com';
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (
          request.auth.token.email == 'rohit.fcg123@gmail.com'
          || (
            exists(/databases/$(database)/documents/approvedAdminEmails/$(request.auth.token.email))
            && get(/databases/$(database)/documents/approvedAdminEmails/$(request.auth.token.email)).data.active == true
          )
        );
    }

    function quizExists(q) {
      return exists(/databases/$(database)/documents/quizzes/$(q));
    }

    function quiz(q) {
      return get(/databases/$(database)/documents/quizzes/$(q)).data;
    }

    function questionStart(q, i) {
      return quiz(q).startedAt
        + duration.value(quiz(q).lead + i * quiz(q).sec, 's');
    }

    // -------------------------
    // Approved Google Admin emails.
    // Only the root Admin can add, disable, or remove approvals.
    // Document ID is the lowercase email address.
    // -------------------------
    match /approvedAdminEmails/{email} {
      allow get: if rootAdmin()
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email == email);
      allow list: if rootAdmin();
      allow create, update: if rootAdmin()
        && request.resource.data.keys().hasOnly(['email', 'active', 'approvedAt', 'approvedBy'])
        && request.resource.data.email is string
        && request.resource.data.email == email
        && request.resource.data.active is bool;
      allow delete: if rootAdmin();
    }

    // -------------------------
    // Legacy UID allowlist (no longer used by the Google-only Admin login)
    // -------------------------
    // Admin allowlist
    // Create this document manually in Firebase Console:
    // admins/{admin UID}, active: true (Boolean)
    // -------------------------
    match /admins/{uid} {
      allow get: if passwordUser() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // -------------------------
    // Optional server-time ping
    // -------------------------
    match /pings/{uid} {
      allow create, update: if passwordUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;

      allow read, delete: if false;
    }

    // -------------------------
    // Quiz metadata
    // -------------------------
    match /quizzes/{q} {
      // Public read of quiz metadata is needed for entering a quiz code
      // and waiting for the host to start. Never store answer keys here.
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      // -------------------------
      // Questions
      // -------------------------
      match /questions/{i} {
        // A Google player can fetch only the currently active question.
        // The live status and currentIndex are controlled by the admin portal.
        // Avoid a timestamp gate here: it can block a valid question when the
        // stored startAt/startedAt and question timer drift or differ in format.
        allow get: if isAdmin()
          || (
            googlePlayer()
            && quizExists(q)
            && quiz(q).status == 'live'
            && quiz(q).currentIndex is int
            && int(i) == quiz(q).currentIndex
          );

        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // Authoritative Firestore start markers are private to the allowlisted Admin.
      match /questionTiming/{i} {
        allow get, list, create, update, delete: if isAdmin();
      }

      // Players can read only the key for a question after their one-time answer
      // has been saved. This enables immediate correct/incorrect feedback without
      // exposing future answer keys before the player locks in a choice.
      match /keys/{i} {
        allow get: if isAdmin()
          || (
            googlePlayer()
            && exists(/databases/$(database)/documents/quizzes/$(q)/answers/$(request.auth.uid + '_' + string(int(i))))
          );
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // -------------------------
      // Players
      // Duplicate display names are allowed.
      // Each player document ID must equal their Firebase Auth UID.
      // -------------------------
      match /players/{uid} {
        allow get: if isAdmin()
          || (googlePlayer() && request.auth.uid == uid);

        allow list: if isAdmin();

        allow create: if googlePlayer()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'email', 'photoURL', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.joinedAt == request.time
          && quizExists(q)
          && quiz(q).status in ['waiting', 'starting', 'live'];

        // Players cannot change scores, names, or answer history from client.
        allow update: if isAdmin()
          || (googlePlayer()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'photoURL'])
            && request.resource.data.email == request.auth.token.email);
        allow delete: if isAdmin();
      }

      // -------------------------
      // One answer per UID per question
      // -------------------------
      match /answers/{aid} {
        // Players may read only their own submitted answer; admins can review all.
        allow get, list: if isAdmin()
          || (googlePlayer() && resource.data.uid == request.auth.uid);

        // Allow one answer per authenticated player for the currently live question.
        // Do not depend on timestamp arithmetic here: it can cause valid answers
        // to be rejected when the client/server clocks or question timer differ.
        allow create: if googlePlayer()
          && request.resource.data.keys().hasOnly(['uid', 'q', 'sel', 'at', 'elapsedMs'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.q is int
          && request.resource.data.sel is int
          && request.resource.data.sel >= 0
          && request.resource.data.sel <= 3
          && request.resource.data.at == request.time
          && request.resource.data.elapsedMs is number
          && request.resource.data.elapsedMs >= 0
          && request.resource.data.elapsedMs <= 600000
          && quizExists(q)
          && quiz(q).status == 'live'
          && request.resource.data.q == quiz(q).currentIndex
          && request.resource.data.q >= 0
          && request.resource.data.q < quiz(q).count
          && aid == request.auth.uid + '_' + string(request.resource.data.q)
          && exists(/databases/$(database)/documents/quizzes/$(q)/players/$(request.auth.uid));

        // Players cannot modify or delete submitted answers.
        allow update, delete: if isAdmin();
      }

      // Each player can read only their own result; admins can read all.
      match /results/{uid} {
        allow get: if isAdmin()
          || (googlePlayer() && request.auth.uid == uid);

        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // -------------------------
    // Public branding settings
    // Only the single branding document can be read publicly.
    // Only an authenticated, allowlisted password Admin can write it.
    // -------------------------
    match /siteSettings/{settingId} {
      allow get: if settingId == 'branding';
      allow list: if false;
      allow create, update: if settingId == 'branding'
        && isAdmin()
        && request.resource.data.keys().hasOnly([
          'preset', 'colors', 'text', 'assets', 'effects', 'updatedAt'
        ]);
      allow delete: if settingId == 'branding' && isAdmin();
    }

    // Deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}