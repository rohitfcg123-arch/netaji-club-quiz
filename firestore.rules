rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function quizData(q) {
      return get(/databases/$(database)/documents/quizzes/$(q)).data;
    }
    function questionOpensAt(q, i) {
      return quizData(q).startedAt
        + duration.value(quizData(q).lead + i * quizData(q).sec, 's');
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /quizzes/{q} {
      // Quiz metadata is readable so players can validate a code and wait for start.
      // Correct answers must NEVER be stored in this document.
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /questions/{i} {
        allow read: if isAdmin() ||
          (quizData(q).status == 'live'
            && request.time >= questionOpensAt(q, int(i)));
        allow create, update, delete: if isAdmin();
      }

      match /keys/{i} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}